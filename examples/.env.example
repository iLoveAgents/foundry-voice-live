# Foundry Voice Live Examples - Configuration
# Copy to .env and fill in your Azure credentials

# ============================================================================
# Azure AI Foundry (Required)
# ============================================================================
VITE_FOUNDRY_RESOURCE_NAME=your-resource-name
VITE_FOUNDRY_API_KEY=your-api-key-here

# ============================================================================
# Avatar Configuration (Optional)
# ============================================================================
# VITE_AVATAR_CHARACTER=lisa
# VITE_AVATAR_STYLE=casual-sitting

# ============================================================================
# Foundry Agents (Optional - for Foundry Agent examples)
# ============================================================================
# Required for both Foundry Agent examples (server-side auth + MSAL).
# The client passes these as URL params so it can dynamically choose agents.
# See: https://learn.microsoft.com/azure/ai-services/speech-service/voice-live-agents-quickstart

# VITE_FOUNDRY_AGENT_NAME=VoiceLiveAgent
# VITE_FOUNDRY_PROJECT_NAME=your-project-name

# ============================================================================
# MSAL Authentication (Optional - for MSAL examples)
# ============================================================================
# Required for: Voice/Avatar MSAL, Foundry Agent MSAL, Agent Service (classic)
# Requires Azure AD app registration with API permission for Azure AI
# See: https://learn.microsoft.com/azure/active-directory/develop/quickstart-register-app

# VITE_AZURE_CLIENT_ID=your-app-client-id
# VITE_AZURE_TENANT_ID=your-tenant-id

# ============================================================================
# Agent Service classic (Optional - for classic Agent Service examples)
# ============================================================================
# VITE_FOUNDRY_AGENT_ID=your-agent-id
