# Foundry Voice Live Examples - Configuration
# Copy to .env and configure the proxy; resource credentials stay server-side

# ============================================================================
# Backend Proxy (Optional - for Proxy / MSAL / Foundry Agent examples)
# ============================================================================
# WebSocket origin of @iloveagents/foundry-voice-live-proxy-node
# (see packages/proxy-node). Defaults to ws://localhost:8080 when unset.
VITE_BACKEND_PROXY_URL=ws://localhost:8080

# ============================================================================
# Avatar Configuration (Optional)
# ============================================================================
# VITE_AVATAR_CHARACTER=lisa
# VITE_AVATAR_STYLE=casual-sitting

# ============================================================================
# Foundry Agents (Optional - for Foundry Agent examples)
# ============================================================================
# Required for both Foundry Agent examples (server-side auth + MSAL).
# The client passes these as URL params so it can dynamically choose agents.
# See: https://learn.microsoft.com/azure/ai-services/speech-service/voice-live-agents-quickstart

# VITE_FOUNDRY_AGENT_NAME=VoiceLiveAgent
# VITE_FOUNDRY_PROJECT_NAME=your-project-name

# ============================================================================
# MSAL Authentication (Optional - for MSAL examples)
# ============================================================================
# Required for: Voice/Avatar MSAL, Foundry Agent MSAL
# Requires Azure AD app registration with API permission for Azure AI
# See: https://learn.microsoft.com/azure/active-directory/develop/quickstart-register-app

# VITE_AZURE_CLIENT_ID=your-app-client-id
# VITE_AZURE_TENANT_ID=your-tenant-id

# ============================================================================
# Bring Your Own Model (Optional - for the /byom example)
# ============================================================================
# Use a model deployed in your own Foundry resource: a fine-tune, a PTU deployment, or a catalog
# model such as Claude or Grok. VITE_BYOM_MODEL is the *deployment name* from the Foundry portal.
# Profiles: byom-azure-openai-realtime | byom-azure-openai-chat-completion | byom-foundry-anthropic-messages
# See: https://learn.microsoft.com/azure/ai-services/speech-service/how-to-bring-your-own-model

# VITE_BYOM_PROFILE=byom-azure-openai-chat-completion
# VITE_BYOM_MODEL=my-gpt-5-deployment
# Only when the deployment lives in a different Foundry resource (needs cross-resource auth):
# VITE_BYOM_RESOURCE_OVERRIDE=other-resource-name
