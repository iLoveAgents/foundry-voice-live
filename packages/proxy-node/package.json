{
  "name": "@iloveagents/foundry-voice-live-proxy-node",
  "version": "0.7.0",
  "description": "Secure WebSocket proxy server for Microsoft Foundry Voice Live API with Express and Docker support",
  "keywords": [
    "microsoft",
    "foundry",
    "voice-live",
    "azure",
    "proxy",
    "websocket",
    "avatar",
    "agent",
    "msal",
    "authentication",
    "typescript",
    "express",
    "docker",
    "security",
    "node"
  ],
  "author": {
    "name": "Christian Glessner",
    "email": "christian@iloveagents.ai",
    "url": "https://iloveagents.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iLoveAgents/foundry-voice-live.git",
    "directory": "packages/proxy-node"
  },
  "homepage": "https://github.com/iLoveAgents/foundry-voice-live#readme",
  "bugs": {
    "url": "https://github.com/iLoveAgents/foundry-voice-live/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/leitwolf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "foundry-voice-live-proxy": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc && node --watch dist/index.js",
    "dev:ts": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist",
    "docker:build": "docker build -f Dockerfile -t foundry-voice-live-proxy ../..",
    "docker:run": "docker run -p 8080:8080 --env-file .env foundry-voice-live-proxy"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "applicationinsights": "^3.17.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-ws": "^5.0.2",
    "helmet": "^7.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-ws": "^3.0.6",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vite": "^8.3.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
