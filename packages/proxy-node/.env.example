# Foundry Voice Live Proxy - Configuration
# Copy to .env and fill in your Azure credentials

# ============================================================================
# Azure AI Foundry (Required)
# ============================================================================
FOUNDRY_RESOURCE_NAME=your-resource-name

# ============================================================================
# Authentication (Optional)
# ============================================================================
# The proxy resolves credentials for the upstream connection in this order:
#   1. Browser token  - ?token=<Entra ID / MSAL access token> from the client
#   2. FOUNDRY_API_KEY - shared API key (standard Voice/Avatar mode only)
#   3. DefaultAzureCredential - server-side, keyless (az login for local dev,
#      managed identity / service principal in production); used for Foundry
#      Agents and for standard mode when neither a token nor an API key exists.
#
# Leave FOUNDRY_API_KEY unset for keyless dev: run `az login` (the identity
# needs the "Cognitive Services User" role on the Foundry resource).
FOUNDRY_API_KEY=your-api-key-here

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8080

# Voice Live API version. Default when unset: 2026-07-15 (GA).
# Clients can override per connection with ?apiVersion=YYYY-MM-DD[-preview].
# WebRTC transport (?transport=webrtc) defaults to 2026-01-01-preview when this
# is unset (the WebRTC control channel is a preview feature).
# API_VERSION=2026-07-15

# CORS: Origins allowed to connect (examples app runs on 3001)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Foundry Agents (Optional - for Foundry Agent mode)
# ============================================================================
# Clients pass agentName + projectName as URL params (plus optional
# conversationId, agentVersion, agentAuthenticationIdentityClientId,
# foundryResourceOverride). These .env values serve as fallbacks when the
# URL params are not provided (and the URL has no model param).
#
# FOUNDRY_AGENT_NAME=VoiceLiveAgent
# FOUNDRY_PROJECT_NAME=your-project-name

# ============================================================================
# Transports
# ============================================================================
# No configuration needed. Clients choose per connection:
#   default            - WebSocket (audio + events over the proxied socket)
#   ?transport=webrtc  - WebRTC (preview): the proxied socket is the WebRTC
#                        control channel (upstream /voice-live/realtime/calls);
#                        media flows directly between browser and Azure.

# ============================================================================
# Security (Optional - defaults shown)
# ============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# MAX_CONNECTIONS=1000

# Express "trust proxy" — set behind an ingress/load balancer so the per-IP rate limit sees
# real client IPs (hop count, true, or an IP/subnet list). Leave unset otherwise: trusting
# X-Forwarded-For when nothing rewrites it lets a client spoof its address.
# TRUST_PROXY=1

# ============================================================================
# Telemetry (Optional)
# ============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
