# Foundry Voice Live Proxy - Configuration
# Copy to .env and fill in your Azure credentials

# ============================================================================
# Azure AI Foundry (Required)
# ============================================================================
FOUNDRY_RESOURCE_NAME=your-resource-name
FOUNDRY_API_KEY=your-api-key-here

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8080
API_VERSION=2025-10-01

# CORS: Origins allowed to connect (examples app runs on 3001)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Foundry Agents (Optional - for Foundry Agent mode)
# ============================================================================
# The proxy handles auth via DefaultAzureCredential (az login for dev,
# managed identity / service principal in production).
# Clients pass agentName + projectName as URL params.
# These .env values serve as fallbacks when URL params are not provided.
#
# IMPORTANT: Set API_VERSION=2026-01-01-preview above for Foundry Agents.
#
# FOUNDRY_AGENT_NAME=VoiceLiveAgent
# FOUNDRY_PROJECT_NAME=your-project-name

# ============================================================================
# Security (Optional - defaults shown)
# ============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# MAX_CONNECTIONS=1000

# ============================================================================
# Telemetry (Optional)
# ============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
