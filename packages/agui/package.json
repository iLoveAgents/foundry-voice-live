{
  "name": "@iloveagents/foundry-voice-live-agui",
  "version": "0.7.0",
  "description": "AG-UI protocol bridge for Microsoft Foundry Voice Live: render a live voice session in CopilotKit or any AG-UI frontend, and verify AG-UI backends for voice readiness.",
  "keywords": [
    "ag-ui",
    "agui",
    "copilotkit",
    "agent-framework",
    "microsoft",
    "foundry",
    "voice-live",
    "azure",
    "react",
    "voice-ai",
    "realtime-ai"
  ],
  "author": {
    "name": "Christian Glessner",
    "email": "christian@iloveagents.ai",
    "url": "https://iloveagents.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iLoveAgents/foundry-voice-live.git",
    "directory": "packages/agui"
  },
  "bugs": {
    "url": "https://github.com/iLoveAgents/foundry-voice-live/issues"
  },
  "homepage": "https://github.com/iLoveAgents/foundry-voice-live#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "foundry-voice-live-agui": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./doctor": {
      "import": {
        "types": "./dist/doctor/index.d.mts",
        "default": "./dist/doctor/index.mjs"
      },
      "require": {
        "types": "./dist/doctor/index.d.ts",
        "default": "./dist/doctor/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58"
  },
  "peerDependencies": {
    "@ag-ui/client": ">=0.0.57",
    "@iloveagents/foundry-voice-live-react": ">=0.7.0",
    "react": ">=16.8.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@iloveagents/foundry-voice-live-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.58",
    "@iloveagents/foundry-voice-live-react": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-json-patch": "^3.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "7.8.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "@types/node": "^22.19.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
