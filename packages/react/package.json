{
  "name": "@iloveagents/foundry-voice-live-react",
  "version": "0.7.0",
  "description": "React library for Microsoft Foundry Voice Live API. Full TypeScript support with optimized presets and configuration helpers.",
  "keywords": [
    "microsoft",
    "foundry",
    "voice-live",
    "azure",
    "react",
    "typescript",
    "voice-ai",
    "realtime-ai",
    "gpt-realtime",
    "speech-to-text",
    "text-to-speech",
    "avatar",
    "webrtc",
    "react-hooks"
  ],
  "author": {
    "name": "Christian Glessner",
    "email": "christian@iloveagents.ai",
    "url": "https://iloveagents.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iLoveAgents/foundry-voice-live.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/iLoveAgents/foundry-voice-live/issues"
  },
  "homepage": "https://github.com/iLoveAgents/foundry-voice-live#readme",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/leitwolf"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@azure/ai-voicelive": "^1.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/ui": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "ws": "^8.18.0",
    "vite": "^8.3.8",
    "@types/node": "^22.19.0",
    "@testing-library/dom": "^10.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
